# Centrum Badminton Arena — Environment Variables Example
# Copy to .env.local and fill in your values

# ── Site URL (OG images, sitemap) ─────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (NEVER expose to browser / do NOT prefix with NEXT_PUBLIC_)
# Used by:
#   - Pengaturan → Staf → Buat Akun Pegawai (owner-only action)
#   - Push fan-out (sendPushToAll) — required for booking notifications
SUPABASE_SERVICE_ROLE_KEY=

# ── Ops scripts (kantin-e2e / promote-owner) ──────────────
# Credentials for scripts/kantin-e2e.mjs — never commit real ones.
# E2E_OWNER_EMAIL=owner@example.com
# E2E_OWNER_PASSWORD=
# E2E_BASE_URL=http://localhost:3000
# Email for scripts/promote-owner.mjs (or pass as argv[1])
# OWNER_EMAIL=owner@example.com

# ── Google Places (dynamic rating badge) ─────────────────
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ── Gemini (AI assistant, Phase 5) ────────────────────────
GEMINI_API_KEY=
# Optional override (default gemini-3.5-flash). Use a current stable model,
# e.g. gemini-3.5-flash / gemini-3.6-flash — older ones get retired by Google.
# GEMINI_MODEL=gemini-3.5-flash

# ── Web Push (PWA notifications) ─────────────────────────
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
