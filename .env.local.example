# Centrum Badminton Arena — environment example
# Copy to .env.local and fill in your values. Never commit .env.local.
#
# NEXT_PUBLIC_* values are bundled into the browser. They are public —
# never put a secret, private key or database URL in one.

# ── Site URL (canonical metadata, sitemap, OG images) ──────
# Production: https://your-domain.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AgentsProxy (single backend for data + auth) ───────────
# The Go proxy origin. No trailing slash. Required in production.
NEXT_PUBLIC_PROXY_URL=http://localhost:8080
# Tenant slug, matching AgentsProxy clients.tenant_id.
NEXT_PUBLIC_TENANT_ID=centrum

# ── Google Places (optional dynamic rating badge) ──────────
# Server-only. Leave empty to use the static fallback rating.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ── Web Push (PWA notifications) ───────────────────────────
# Public VAPID key only. The PRIVATE key belongs in AgentsProxy/.env.
# Generate a key pair once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Ops scripts (optional; never commit real credentials) ──
# Used by scripts/kantin-e2e.mjs
# E2E_OWNER_EMAIL=owner@example.com
# E2E_OWNER_PASSWORD=
# E2E_BASE_URL=http://localhost:3000
# Used by scripts/promote-owner.mjs (or pass the email as argv[1])
# OWNER_EMAIL=owner@example.com
# Optional client token for scripts/provision-owner.mjs on a fresh tenant
# PROXY_CLIENT_TOKEN=
