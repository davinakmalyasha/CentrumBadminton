# Centrum Badminton Arena — Environment Variables Example
# Copy to .env.local and fill in your values

# ── Supabase ──────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (NEVER expose to browser / do NOT prefix with NEXT_PUBLIC_)
# Used later for staff account creation (owner-only action)
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Places (dynamic rating badge) ─────────────────
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ── Gemini (AI assistant, Phase 5) ────────────────────────
GEMINI_API_KEY=
