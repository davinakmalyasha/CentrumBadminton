# Centrum Badminton Arena — Environment Variables Example
# Copy to .env.local and fill in your values

# ── Site URL (OG images, sitemap) ─────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AgentsProxy (replaces Supabase) ───────────────────────
# The unified backend — the proxy serves all data + auth.
NEXT_PUBLIC_PROXY_URL=http://localhost:8080
# The tenant slug for this client (matches the proxy's clients.tenant_id).
NEXT_PUBLIC_TENANT_ID=centrum

# ── Supabase ──────────────────────────────────────────────
# Removed — the proxy replaces Supabase. See src/lib/proxy/.
# No Supabase keys required. Staff creation uses POST /v1/auth/register
# with X-Session-Token; push is via Telegram (proxy) — web-push is no-op.

# ── Ops scripts (kantin-e2e / promote-owner) ──────────────
# Credentials for scripts/kantin-e2e.mjs — never commit real ones.
# E2E_OWNER_EMAIL=owner@example.com
# E2E_OWNER_PASSWORD=
# E2E_BASE_URL=http://localhost:3000
# Email for scripts/promote-owner.mjs (or pass as argv[1])
# OWNER_EMAIL=owner@example.com

# ── Google Places (dynamic rating badge) ─────────────────
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ── AI (via AgentsProxy — single shared LLM_API_KEY in AgentsProxy/.env) ─────────
# No key here. Dashboard & landing chat call AgentsProxy POST /v1/agent/chat (owner/pegawai)
# and POST /v1/sports/agent/client-chat (client) with X-Session-Token / tenant_id.
# AgentsProxy LLM: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/ + LLM_MODEL=gemini-2.0-flash + LLM_API_KEY=AIza...

# ── Web Push (PWA notifications) ─────────────────────────
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
